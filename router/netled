#!/bin/sh
# Internet status: feeds every ESP32-S3 board on USB serial (see
# /etc/init.d/netled) and publishes the state to /tmp/netled.state for the
# LCD's flame-screen.
# B = online, A = first failures / reconnecting, R = offline (3+ failed rounds, ~15 s).
INTERVAL=5

# Every Espressif (vendor 303a) board, one per line: "<tty> <usb serial>".
find_ttys() {
  for d in /sys/bus/usb/devices/*; do
    [ "$(cat "$d/idVendor" 2>/dev/null)" = "303a" ] || continue
    for t in "$d"/*/tty/ttyACM*; do
      [ -e "$t" ] && echo "/dev/${t##*/} $(cat "$d/serial" 2>/dev/null)"
    done
  done
}

# Each board keeps its own open file descriptor, 3-6, so up to four boards.
# Opening and closing an ESP32-S3's USB serial port toggles DTR/RTS, which can
# reset the chip, so a board's port stays open for as long as it is present.
# tty_N is the port open on fd N and ser_N that board's USB serial number.
FDS="3 4 5 6"

get_tty() { eval "echo \"\${tty_$1}\""; }
set_tty() { eval "tty_$1=\$2"; }
get_ser() { eval "echo \"\${ser_$1}\""; }
set_ser() { eval "ser_$1=\$2"; }
write_fd() { eval "echo \"\$2\" >&$1" 2>/dev/null; }

# Settings (settings.schema.json), keyed by board USB serial number. Each
# board gets "S reset" and then its own values, numeric ones only, so a typo in
# the file cannot inject a command.
SETTINGS_FILE=/etc/status-light.json
# Wisps are the flame the LCD board shows; the heat-field flame keys are for
# displays that sample it instead.
WISP_KEYS="strands height sway speed glow width"
FLAME_KEYS="cooling drift flicker seed_min seed_max blue_full green_start white_start"

settings_for() {
  ser=$1
  echo "S reset"
  [ -n "$ser" ] && [ -f "$SETTINGS_FILE" ] || return 0
  setting brightness brightness
  for k in $WISP_KEYS; do setting "$k" "wisps.$k"; done
  for k in $FLAME_KEYS; do setting "$k" "flame.$k"; done
}

# setting <key> <json path under the board>: one S line, if set and numeric.
setting() {
  v=$(jsonfilter -i "$SETTINGS_FILE" -e "@.boards[\"$ser\"].$2" 2>/dev/null)
  case "$v" in ''|*[!0-9]*) ;; *) echo "S $1 $v" ;; esac
}

send_settings() {
  fd=$1
  settings_for "$(get_ser "$fd")" | while read -r line; do
    write_fd "$fd" "$line" || return 1
  done
}

sync_boards() {
  for fd in $FDS; do
    t=$(get_tty "$fd")
    if [ -n "$t" ] && [ ! -e "$t" ]; then
      eval "exec $fd>&-"
      set_tty "$fd" ""
      set_ser "$fd" ""
      logger -t netled "lost $t"
    fi
  done
  find_ttys > /tmp/netled.ttys
  while read -r t ser; do
    known=""
    for fd in $FDS; do
      [ "$(get_tty "$fd")" = "$t" ] && known=1
    done
    [ -n "$known" ] && continue
    for fd in $FDS; do
      [ -z "$(get_tty "$fd")" ] || continue
      if eval "exec $fd>\"\$t\""; then
        set_tty "$fd" "$t"
        set_ser "$fd" "$ser"
        logger -t netled "using $t (serial $ser)"
        send_settings "$fd"
      fi
      break
    done
  done < /tmp/netled.ttys
}

# Re-send every board its settings when the settings file changes. Seeded at
# startup: boards opened by sync_boards already got the current settings.
settings_seen=$(date -r "$SETTINGS_FILE" +%s 2>/dev/null)
check_settings() {
  m=$(date -r "$SETTINGS_FILE" +%s 2>/dev/null)
  [ "$m" = "$settings_seen" ] && return
  settings_seen=$m
  for fd in $FDS; do
    [ -n "$(get_tty "$fd")" ] && send_settings "$fd"
  done
}

send_boards() {
  for fd in $FDS; do
    t=$(get_tty "$fd")
    [ -n "$t" ] || continue
    if ! eval "echo \"\$1\" >&$fd" 2>/dev/null; then
      eval "exec $fd>&-"
      set_tty "$fd" ""
      logger -t netled "write failed on $t"
    fi
  done
}

# Internet check. ICMP is unreliable on some ISP paths (Bell's PPPoE silently
# drops ping, including to the on-link peer), so probe real connectivity with a
# DNS query sent over the WAN to public resolvers. Any resolver answering within
# the timeout means we are online. `timeout` guards against a hung query.
RESOLVERS="1.1.1.1 8.8.8.8 9.9.9.9"
PROBE_NAME="cloudflare.com"

online() {
  for r in $RESOLVERS; do
    timeout 3 nslookup "$PROBE_NAME" "$r" >/dev/null 2>&1 && return 0
  done
  return 1
}

# State for other consumers (the LCD's flame-screen). Rewritten every cycle, so
# a stale file means netled itself stopped.
STATE_FILE=/tmp/netled.state

publish() {
  echo "$1" > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"
}

fails=0
while true; do
  if online; then
    fails=0
    state=B
  else
    fails=$((fails + 1))
    [ "$fails" -ge 3 ] && state=R || state=A
  fi
  publish "$state"

  # Drive every USB status board plugged in; pick up new ones, drop removed.
  sync_boards
  check_settings
  send_boards "$state"
  sleep "$INTERVAL"
done
