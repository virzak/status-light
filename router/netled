#!/bin/sh
# Internet status: feeds the ESP32-S3 on USB serial (see /etc/init.d/netled)
# and publishes the state to /tmp/netled.state for the LCD's flame-screen.
# B = online, A = first failures / reconnecting, R = offline (3+ failed rounds, ~15 s).
INTERVAL=5

find_tty() {
  for d in /sys/bus/usb/devices/*; do
    [ "$(cat "$d/idVendor" 2>/dev/null)" = "303a" ] || continue
    for t in "$d"/*/tty/ttyACM*; do
      [ -e "$t" ] && { echo "/dev/${t##*/}"; return 0; }
    done
  done
  return 1
}

# Internet check. ICMP is unreliable on some ISP paths (Bell's PPPoE silently
# drops ping, including to the on-link peer), so probe real connectivity with a
# DNS query sent over the WAN to public resolvers. Any resolver answering within
# the timeout means we are online. `timeout` guards against a hung query.
RESOLVERS="1.1.1.1 8.8.8.8 9.9.9.9"
PROBE_NAME="cloudflare.com"

online() {
  for r in $RESOLVERS; do
    timeout 3 nslookup "$PROBE_NAME" "$r" >/dev/null 2>&1 && return 0
  done
  return 1
}

# State for other consumers (the LCD's flame-screen). Rewritten every cycle, so
# a stale file means netled itself stopped.
STATE_FILE=/tmp/netled.state

publish() {
  echo "$1" > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"
}

tty=""
fails=0
while true; do
  if online; then
    fails=0
    state=B
  else
    fails=$((fails + 1))
    [ "$fails" -ge 3 ] && state=R || state=A
  fi
  publish "$state"

  # Drive a USB status board if one is plugged in; find it again after replug.
  if [ -n "$tty" ] && [ ! -e "$tty" ]; then
    exec 3>&-
    logger -t netled "lost $tty"
    tty=""
  fi
  if [ -z "$tty" ] && t=$(find_tty); then
    exec 3>"$t" && tty=$t && logger -t netled "using $tty"
  fi
  if [ -n "$tty" ]; then
    echo "$state" >&3 2>/dev/null || {
      exec 3>&-
      logger -t netled "write failed on $tty"
      tty=""
    }
  fi
  sleep "$INTERVAL"
done
