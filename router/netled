#!/bin/sh
# Internet status: feeds every ESP32-S3 board on USB serial (see
# /etc/init.d/netled) and publishes the state to /tmp/netled.state for the
# LCD's flame-screen.
# B = online, A = first failures / reconnecting, R = offline (3+ failed rounds, ~15 s).
INTERVAL=5

# Every Espressif (vendor 303a) board, one per line: "<tty> <usb serial>".
find_ttys() {
  for d in /sys/bus/usb/devices/*; do
    [ "$(cat "$d/idVendor" 2>/dev/null)" = "303a" ] || continue
    for t in "$d"/*/tty/ttyACM*; do
      [ -e "$t" ] && echo "/dev/${t##*/} $(cat "$d/serial" 2>/dev/null)"
    done
  done
}

# Each board keeps its own open file descriptor, 3-6, so up to four boards.
# Opening and closing an ESP32-S3's USB serial port toggles DTR/RTS, which can
# reset the chip, so a board's port stays open for as long as it is present.
# tty_N is the port open on fd N and ser_N that board's USB serial number.
FDS="3 4 5 6"

get_tty() { eval "echo \"\${tty_$1}\""; }
set_tty() { eval "tty_$1=\$2"; }
get_ser() { eval "echo \"\${ser_$1}\""; }
set_ser() { eval "ser_$1=\$2"; }

# Each board answers every state command with a status line (PROTOCOL.md):
# "I <firmware> <version> <uptime>". A reader per board, in the background so
# a silent board never holds netled up, keeps the latest in
# $BOARDS_DIR/<usb serial>, for the settings page; the file's age says when
# the board last answered. Readers stop with netled (the trap below) or, if it
# was killed outright, within 10 s; router-flash.sh waits for that, as a
# leftover reader would take espflash's replies.
BOARDS_DIR=/tmp/status-light/boards
NETLED_PID=$$

# read_board <usb serial> <tty>, with the tty on stdin. Lines are kept only
# when they hold nothing but the characters a status line uses.
read_board() {
  f="$BOARDS_DIR/$1"
  while kill -0 "$NETLED_PID" 2>/dev/null; do
    # A timeout and a closed port look alike to busybox read: carry on while
    # the port is there.
    if IFS= read -r -t 10 line; then
      case "$line" in
        "I "*[!a-zA-Z0-9\ ._~+-]* | "I ") ;;
        "I "*) echo "$line" > "$f.tmp" && mv "$f.tmp" "$f" ;;
      esac
    else
      [ -e "$2" ] || break
    fi
  done
}

# start_reader <fd>: the board's reader, with only that board's tty open.
start_reader() {
  ser=$(get_ser "$1")
  case "$ser" in '' | *[!A-Za-z0-9:_-]*) return ;; esac
  mkdir -p "$BOARDS_DIR"
  (exec 3>&- 4>&- 5>&- 6>&-; read_board "$ser" "$(get_tty "$1")") <&"$1" &
  eval "reader_$1=$!"
}

stop_reader() {
  r=$(eval "echo \"\${reader_$1}\"")
  [ -n "$r" ] && kill "$r" 2>/dev/null
  eval "reader_$1="
}

trap 'for fd in $FDS; do stop_reader "$fd"; done' EXIT
trap 'exit 0' TERM INT

# Write one line to the board on fd $1. A board whose USB link wedges (seen
# when another device on the same hub keeps failing to enumerate) never takes
# the data, and a plain write would then block netled forever and freeze every
# board and the LCD. So write from a child under a time limit: exit status 0
# is written, 124 or more is timed out, anything else is a failed write.
write_fd() { timeout 2 sh -c 'echo "$2" >&$1' _ "$1" "$2" 2>/dev/null; }

# Settings (settings.schema.json), keyed by board USB serial number. Each
# board gets "S reset" and then its own values, numeric ones only, so a typo in
# the file cannot inject a command.
SETTINGS_FILE=/etc/status-light.json
# Wisps are the flame the LCD board shows; the strip keys are for a board with
# an LED strip (sent as strip_<key>).
WISP_KEYS="strands height sway speed glow width"
STRIP_KEYS="leds speed width balance sharpness identify"

settings_for() {
  ser=$1
  echo "S reset"
  [ -n "$ser" ] && [ -f "$SETTINGS_FILE" ] || return 0
  setting brightness brightness
  for k in $WISP_KEYS; do setting "$k" "wisps.$k"; done
  for k in $STRIP_KEYS; do setting "strip_$k" "strip.$k"; done
  name_setting strip_pattern strip.pattern
  name_setting strip_gradient strip.gradient
  name_setting strip_edge strip.edge
  color_setting strip_primary strip.primary
  color_setting strip_secondary strip.secondary
  color_setting strip_background strip.background
}

# setting <key> <json path under the board>: one S line, if set and numeric (a
# boolean is sent as 1 or 0).
setting() {
  v=$(jsonfilter -i "$SETTINGS_FILE" -e "@.boards[\"$ser\"].$2" 2>/dev/null)
  case "$v" in true) v=1 ;; false) v=0 ;; esac
  case "$v" in ''|*[!0-9]*) ;; *) echo "S $1 $v" ;; esac
}

# name_setting <key> <json path>: one S line for a value that is a name, such
# as a pattern; only a plain lowercase word is passed, so nothing else can reach
# the board.
name_setting() {
  v=$(jsonfilter -i "$SETTINGS_FILE" -e "@.boards[\"$ser\"].$2" 2>/dev/null)
  case "$v" in ''|*[!a-z_]*) ;; *) echo "S $1 $v" ;; esac
}

# color_setting <key> <json path>: one S line for a #rrggbb or #rgb colour,
# passed only if it is exactly that.
color_setting() {
  v=$(jsonfilter -i "$SETTINGS_FILE" -e "@.boards[\"$ser\"].$2" 2>/dev/null)
  h='[0-9a-fA-F]'
  case "$v" in \#$h$h$h$h$h$h|\#$h$h$h) echo "S $1 $v" ;; esac
}

send_settings() {
  fd=$1
  settings_for "$(get_ser "$fd")" | while read -r line; do
    write_fd "$fd" "$line" || return 1
  done
}

sync_boards() {
  for fd in $FDS; do
    t=$(get_tty "$fd")
    if [ -n "$t" ] && [ ! -e "$t" ]; then
      eval "exec $fd>&-"
      stop_reader "$fd"
      set_tty "$fd" ""
      set_ser "$fd" ""
      logger -t netled "lost $t"
    fi
  done
  find_ttys > /tmp/netled.ttys
  while read -r t ser; do
    known=""
    for fd in $FDS; do
      [ "$(get_tty "$fd")" = "$t" ] && known=1
    done
    [ -n "$known" ] && continue
    for fd in $FDS; do
      [ -z "$(get_tty "$fd")" ] || continue
      # Read-write: the board's status lines come back on the same port.
      if eval "exec $fd<>\"\$t\""; then
        set_tty "$fd" "$t"
        set_ser "$fd" "$ser"
        logger -t netled "using $t (serial $ser)"
        start_reader "$fd"
        send_settings "$fd"
      fi
      break
    done
  done < /tmp/netled.ttys
}

# Re-send every board its settings when the settings file changes. Seeded at
# startup: boards opened by sync_boards already got the current settings.
settings_seen=$(date -r "$SETTINGS_FILE" +%s 2>/dev/null)
check_settings() {
  m=$(date -r "$SETTINGS_FILE" +%s 2>/dev/null)
  [ "$m" = "$settings_seen" ] && return
  settings_seen=$m
  for fd in $FDS; do
    [ -n "$(get_tty "$fd")" ] && send_settings "$fd"
  done
}

# A board that stops taking data is left open rather than closed: closing a
# tty with output stuck in it can itself block for half a minute. It is
# retried every cycle and picks up again if its link recovers.
send_boards() {
  for fd in $FDS; do
    t=$(get_tty "$fd")
    [ -n "$t" ] || continue
    write_fd "$fd" "$1"
    rc=$?
    stuck=$(eval "echo \"\${stuck_$fd}\"")
    if [ "$rc" -eq 0 ]; then
      [ -n "$stuck" ] && logger -t netled "$t taking data again"
      eval "stuck_$fd="
    elif [ "$rc" -ge 124 ]; then
      [ -z "$stuck" ] && logger -t netled "$t not taking data; retrying each cycle"
      eval "stuck_$fd=1"
    else
      eval "exec $fd>&-"
      stop_reader "$fd"
      set_tty "$fd" ""
      eval "stuck_$fd="
      logger -t netled "write failed on $t"
    fi
  done
}

# Internet check. ICMP is unreliable on some ISP paths (Bell's PPPoE silently
# drops ping, including to the on-link peer), so probe real connectivity with a
# DNS query sent over the WAN to public resolvers. Any resolver answering within
# the timeout means we are online. `timeout` guards against a hung query.
RESOLVERS="1.1.1.1 8.8.8.8 9.9.9.9"
PROBE_NAME="cloudflare.com"

online() {
  for r in $RESOLVERS; do
    timeout 3 nslookup "$PROBE_NAME" "$r" >/dev/null 2>&1 && return 0
  done
  return 1
}

# State for other consumers (the LCD's flame-screen). Rewritten every cycle, so
# a stale file means netled itself stopped.
STATE_FILE=/tmp/netled.state

publish() {
  echo "$1" > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"
}

fails=0
while true; do
  if online; then
    fails=0
    state=B
  else
    fails=$((fails + 1))
    [ "$fails" -ge 3 ] && state=R || state=A
  fi
  publish "$state"

  # Drive every USB status board plugged in; pick up new ones, drop removed.
  sync_boards
  check_settings
  send_boards "$state"
  # In the background, so a stop (TERM) is handled at once, not after it.
  sleep "$INTERVAL" &
  wait $!
done
