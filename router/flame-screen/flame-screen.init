#!/bin/sh /etc/rc.common
# Blue-flame internet status on the router's built-in LCD instead of GL's
# screen UI. Reads the state netled publishes to /tmp/netled.state.
#
#   Use:    /etc/init.d/flame-screen enable && /etc/init.d/flame-screen start
#   Revert: /etc/init.d/flame-screen stop && /etc/init.d/flame-screen disable
#
# The flame is the idle screen; touching the panel brings up GL's screen UI,
# and the flame returns after a minute without touches. gl_screen stays
# enabled; this service restarts it on stop, so disabling this one is all it
# takes to go back to the stock screen.

START=99
USE_PROCD=1

start_service() {
  # flame-screen stops gl_screen itself (and waits for procd's SIGKILL, since
  # gl_screen ignores SIGTERM), so a procd respawn is covered too.
  procd_open_instance
  procd_set_param command /usr/bin/flame-screen
  procd_set_param respawn
  procd_close_instance
}

service_stopped() {
  /etc/init.d/gl_screen start
}
