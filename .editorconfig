root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

# The settings page follows LuCI's own style (it is compiled into a LuCI view
# and its code is offered upstream), which indents with tabs.
[luci-src/*.ts]
indent_style = tab
indent_size = 4
