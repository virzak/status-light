{
  "luci-app-status-light": {
    "description": "Grant access to the status-light settings file",
    "read": {
      "file": {
        "/etc/status-light.json": ["read"],
        "/etc/init.d/flame-screen": ["read"],
        "/tmp/status-light/boards": ["list"],
        "/tmp/status-light/boards/*": ["read"],
        "/sys/bus/usb/devices": ["list"],
        "/sys/bus/usb/devices/*/idVendor": ["read"],
        "/sys/bus/usb/devices/*/serial": ["read"],
        "/sys/bus/usb/devices/*/product": ["read"]
      }
    },
    "write": {
      "file": {
        "/etc/status-light.json": ["write"]
      }
    }
  }
}
