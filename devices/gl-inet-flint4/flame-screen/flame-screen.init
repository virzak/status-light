#!/bin/sh /etc/rc.common
# Blue-flame internet status on the router's built-in LCD instead of GL's
# screen UI. Reads the state netled publishes to /tmp/netled.state.
#
#   Use:    /etc/init.d/flame-screen enable && /etc/init.d/flame-screen start
#   Revert: /etc/init.d/flame-screen stop && /etc/init.d/flame-screen disable
#
# The flame fills the screen while GL's screen UI sleeps (its own screen
# timeout); a touch wakes GL's UI as usual. gl_screen keeps running, and
# stopping this service restarts it so it repaints the whole panel, so
# disabling this one is all it takes to go back to the stock screen.

START=99
USE_PROCD=1

start_service() {
  procd_open_instance
  procd_set_param command /usr/bin/flame-screen
  procd_set_param respawn
  procd_close_instance
}

service_stopped() {
  /etc/init.d/gl_screen restart
}
